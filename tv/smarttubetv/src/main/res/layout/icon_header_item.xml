<?xml version="1.0" encoding="utf-8"?>
<!-- Tube OTTMTY: menú lateral con iconos y texto; el elemento activo se resalta con una píldora. -->
<androidx.leanback.widget.NonOverlappingLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Línea que separa el grupo de abajo (Ajustes). La muestra IconHeaderItemPresenter. -->
    <View
        android:id="@+id/header_divider"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="#55FFFFFF"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/header_pill"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="22dp"
        android:background="@drawable/header_item_bg"
        android:duplicateParentState="true">

        <ImageView
            android:id="@+id/header_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/header_icon" />

        <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.marqueetextviewcompat.HeaderMarqueeTextViewCompat
            android:id="@+id/header_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"

            android:singleLine="true"
            android:maxWidth="190sp"
            android:marqueeRepeatLimit="marquee_forever"
            android:ellipsize="marquee"
            android:scrollHorizontally="true"

            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"

            style="@style/TextAppearance.Leanback.Header"/>
    </LinearLayout>
</androidx.leanback.widget.NonOverlappingLinearLayout>
